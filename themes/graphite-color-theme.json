    "dropdown.border": "#4a4a4a",
    "button.background": "#3D7FE0",
    "button.foreground": "#ffffff",
    "button.hoverBackground": "#1473e6",
    "button.secondaryBackground": "#1f1f1f",
    "button.secondaryForeground": "#d4d4d4",
    "list.hoverBackground": "#3d3d3d",
    "list.activeSelectionBackground": "#34495e",
    "list.activeSelectionForeground": "#ffffff",
    "list.inactiveSelectionBackground": "#3d3d3d",
    "list.focusOutline": "#3D7FE0",
    "list.highlightForeground": "#3D7FE0",
    "tree.indentGuidesStroke": "#1c1c1c",
    "menu.background": "#323232",
    "menu.foreground": "#d4d4d4",
    "menu.selectionBackground": "#3D7FE0",
    "menu.selectionForeground": "#ffffff",
    "menu.border": "#1c1c1c",
    "editorWidget.background": "#323232",
    "editorWidget.border": "#1c1c1c",
    "quickInput.background": "#323232",
    "quickInputList.focusBackground": "#34495e",
    "pickerGroup.foreground": "#3D7FE0",
    "badge.background": "#3D7FE0",
    "badge.foreground": "#ffffff",
    "progressBar.background": "#3D7FE0",
    "scrollbarSlider.background": "#ffffff1a",
    "scrollbarSlider.hoverBackground": "#ffffff2a",
    "scrollbarSlider.activeBackground": "#ffffff3a",
    "breadcrumb.foreground": "#9a9a9a",
    "breadcrumb.focusForeground": "#d4d4d4",
    "breadcrumb.activeSelectionForeground": "#d4d4d4",
    "breadcrumb.background": "#1e1e1e",
    "terminal.background": "#323232",
    "terminal.foreground": "#d4d4d4",
    "textLink.foreground": "#3D7FE0",
    "textLink.activeForeground": "#3D7FE0",
    "notifications.background": "#323232",
    "notifications.border": "#1c1c1c",
    "checkbox.background": "#1f1f1f",
    "checkbox.border": "#4a4a4a"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7f8c8d",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted"
      ],
      "settings": {
        "foreground": "#e6db74"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other.color"
      ],
      "settings": {
        "foreground": "#ae81ff"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "keyword.control"
      ],
      "settings": {
        "foreground": "#f92672"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "meta.tag.sgml",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#4fa6ff"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css"
      ],
      "settings": {
        "foreground": "#a6e22e"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "meta.property-name"
      ],
      "settings": {
        "foreground": "#66d9ef"
      }
    },
    {
      "scope": [
        "support.constant.property-value",
        "meta.property-value",
        "support.constant"
      ],
      "settings": {
        "foreground": "#e6db74"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#a6e22e"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#d4d4d4"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.class",
        "entity.name.class"
      ],
      "settings": {
        "foreground": "#66d9ef"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#9a9a9a"
      }
    }
  ]
}