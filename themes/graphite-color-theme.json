    "sideBarSectionHeader.border": "#1c1c1c",
    "editor.background": "#1e1e1e",
    "editor.foreground": "#d4d4d4",
    "editorLineNumber.foreground": "#9a9a9a",
    "editorLineNumber.activeForeground": "#d4d4d4",
    "editor.selectionBackground": "#3D7FE055",
    "editor.lineHighlightBackground": "#3d3d3d80",
    "editorCursor.foreground": "#3D7FE0",
    "editorIndentGuide.background1": "#1c1c1c",
    "editorWhitespace.foreground": "#1c1c1c",
    "editorGroupHeader.tabsBackground": "#282828",
